    {
      "name": "BANK_CLIENTS",
      "physicalName": "BANK1/BANK_CLIENTS",
      "physicalType": "table",
      "logicalType": "object",
      "quality": [
        {
          "name": "table_row_counts",
          "type": "sql",
          "query": "SELECT * FROM BANK1.BANK_CLIENTS;",
          "mustBeGreaterThan": 1000,
          "dimension": "completeness"
        },
        {
          "name": "Senior clients with young marital status mismatch",
          "type": "sql",
          "query": "SELECT AGE, MARITAL_STATUS FROM BANK1.BANK_CLIENTS WHERE AGE > 90 AND MARITAL_STATUS = 'single';",
          "mustBeLessThan": 50
        },
        {
          "name": "Clients with missing phone number",
          "type": "sql",
          "query": "SELECT * FROM BANK1.BANK_CLIENTS WHERE PHONE1 IS NULL;",
          "dimension": "completeness",
          "mustBeLessThan": 4000
        }
      ],
      "properties": [
        {
          "name": "ACCOUNT_ID",
          "physicalName": "ACCOUNT_ID",
          "logicalType": "integer",
          "quality": [
            {
              "name": "Null Values Check for ACCOUNT_ID",
              "type": "sql",
              "query": "SELECT * FROM BANK1.BANK_CLIENTS WHERE ACCOUNT_ID IS NULL;",
              "dimension": "accuracy",
              "mustBeLessThan": 10
            },
            {
              "name": "Missing Values for Account IDs",
              "type": "library",
              "metric": "missingValues",
              "arguments": {
                "missingValues": [
                  "",
                  "n/a",
                  "N/A",
                  "none",
                  "NONE"
                ]
              },
              "mustBeLessThan": 10
            },
            {
              "name": "Duplicate account IDs via library check",
              "type": "library",
              "metric": "duplicateValues",
              "mustBeLessThan": 100
            }
          ],
          "primaryKey": false,
          "unique": true,
          "required": true
        },
        {
          "name": "ZIP",
          "physicalName": "ZIP",
          "logicalType": "string",
          "quality": [
            {
              "name": "Invalid ZIP format",
              "type": "sql",
              "query": "SELECT ZIP FROM BANK1.BANK_CLIENTS WHERE ZIP IS NOT NULL AND NOT REGEXP_LIKE(TRIM(ZIP),'^[0-9]{5}$');",
              "mustBeLessThan": 4000
            },
            {
              "name": "Invalid ZIP format via Library check",
              "type": "library",
              "metric": "invalidValues",
              "arguments": {
                "pattern": "^[0-9]{5}$"
              },
              "mustBeLessThan": 4000
            }
          ],
          "primaryKey": false,
          "unique": true,
          "required": true
        },
        {
          "name": "AGE",
          "physicalName": "AGE",
          "logicalType": "number",
          "quality": [
            {
              "name": "Underage or very old customers",
              "type": "sql",
              "query": "SELECT AGE FROM BANK1.BANK_CLIENTS WHERE AGE IS NULL OR AGE < 21 OR AGE > 90;",
              "mustBeBetween": [
                0,
                1000
              ]
            }
          ],
          "primaryKey": false,
          "unique": true,
          "required": true
        },
        {
          "name": "EMAIL",
          "physicalName": "EMAIL",
          "logicalType": "string",
          "quality": [
            {
              "name": "Email missing @ symbol",
              "type": "sql",
              "query": "SELECT EMAIL FROM BANK1.BANK_CLIENTS WHERE EMAIL IS NOT NULL AND EMAIL NOT LIKE '%@%';",
              "mustBeLessThan": 10
            }
          ],
          "primaryKey": false,
          "unique": true,
          "required": true
        },
        {
          "name": "GENDER",
          "physicalName": "GENDER",
          "logicalType": "string",
          "quality": [
            {
              "name": "Unexpected gender codes",
              "type": "sql",
              "query": "SELECT GENDER FROM BANK1.BANK_CLIENTS WHERE GENDER NOT IN ('M','F');",
              "mustBeLessThan": 5200
            },
            {
              "name": "Unexpected gender codes via library check",
              "type": "library",
              "metric": "invalidValues",
              "arguments": {
                "validValues": [
                  "M",
                  "F"
                ]
              },
              "mustBeLessThan": 5200
            }
          ],
          "primaryKey": false,
          "unique": true,
          "required": true
        },
        {
          "name": "MARITAL_STATUS",
          "physicalName": "MARITAL_STATUS",
          "logicalType": "string",
          "quality": [
            {
              "name": "Invalid marital status codes",
              "type": "sql",
              "query": "SELECT MARITAL_STATUS FROM BANK1.BANK_CLIENTS WHERE MARITAL_STATUS NOT IN ('single','married','divorced','widowed','unknown');",
              "mustBeBetween": [
                0,
                5200
              ]
            }
